{
  "$meta": {
    "name": "Debye v2 · Version B (impeccable)",
    "skill": "https://github.com/pbakaus/impeccable (Operate mode)",
    "figma": "https://www.figma.com/design/vW4cyvW7lLOjYGOg7Ul1iJ — page 'Version B – impeccable'",
    "usage": "Map into frontend/src/theme.ts. Elevation is borders only; no shadows."
  },
  "color": {
    "shell": {
      "rail": "#0B1F3A",
      "railActive": "#1C3456",
      "railText": "#C9D3E3",
      "railTextActive": "#FFFFFF"
    },
    "surface": {
      "ground": "#F2F5F9",
      "work": "#FFFFFF",
      "sub": "#EEF2F7"
    },
    "border": {
      "default": "#DCE3EC"
    },
    "text": {
      "primary": "#0B1F3A",
      "secondary": "#44536A",
      "muted": "#66758C",
      "onAction": "#FFFFFF"
    },
    "action": {
      "base": "#2E5BBA",
      "soft": "#E7EEFA",
      "note": "Primary buttons, selection, the current station on the lifecycle line, links"
    },
    "state": {
      "positive": "#067647",
      "positiveSoft": "#E5F4EC",
      "negative": "#B42318",
      "negativeSoft": "#FCEBE9",
      "warning": "#B54708",
      "warningSoft": "#FEF3E2"
    },
    "lifecycle": {
      "done": "#0B1F3A",
      "current": "#2E5BBA",
      "upcoming": "#A9B6C8",
      "track": "#C9D3E0"
    }
  },
  "font": {
    "sans": "'Public Sans', system-ui, sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&display=swap",
    "weights": [
      400,
      500,
      600
    ],
    "notes": "One family, tabular figures (font-variant-numeric: tabular-nums). No eyebrows/kickers, no monospace costume."
  },
  "fontSize": {
    "pageTitle": {
      "size": 30,
      "lineHeight": 36,
      "weight": 600,
      "letterSpacing": "-0.01em"
    },
    "panelTitle": {
      "size": 18,
      "lineHeight": 27,
      "weight": 600
    },
    "body": {
      "size": 16,
      "lineHeight": 24
    },
    "secondary": {
      "size": 15,
      "lineHeight": 22
    },
    "label": {
      "size": 14,
      "lineHeight": 21
    },
    "meta": {
      "size": 13,
      "lineHeight": 19
    },
    "rail": {
      "size": 12,
      "lineHeight": 16
    }
  },
  "radius": {
    "chip": 6,
    "control": 8,
    "panel": 12
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48
  ],
  "layout": {
    "rail": 72,
    "header": 64,
    "workPadding": 24,
    "gap": 24,
    "inspector": 360,
    "conversation": 360,
    "tableRow": 64,
    "panelHeader": "16px 20px, bottom border"
  },
  "elevation": {
    "rule": "1px #DCE3EC border on panels; no shadows anywhere"
  },
  "motion": {
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "hover": "140ms",
    "moment": "the current lifecycle station fills when a step completes (one authored moment)"
  },
  "component": {
    "buttonPrimary": {
      "bg": "#2E5BBA",
      "fg": "#FFFFFF",
      "radius": 8,
      "height": 44,
      "padding": "0 18px",
      "weight": 600
    },
    "buttonSecondary": {
      "bg": "#FFFFFF",
      "fg": "#0B1F3A",
      "border": "1px #DCE3EC",
      "radius": 8
    },
    "chip": {
      "radius": 6,
      "padding": "3px 10px",
      "weight": 600,
      "note": "text in state colour on its soft tint"
    },
    "lifecycleLine": {
      "stations": [
        "Reported",
        "Consent",
        "Dispatched",
        "Booked",
        "Done",
        "Invoiced",
        "Closed"
      ],
      "dot": 12,
      "currentDot": 18,
      "track": 3
    },
    "weekGrid": {
      "cellHeight": 40,
      "states": [
        "Free",
        "Busy",
        "Offered"
      ]
    },
    "avatar": "docs/design/v2/mascot/debye-mascot-avatar-256.png"
  }
}