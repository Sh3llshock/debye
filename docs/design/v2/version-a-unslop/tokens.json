{
  "$meta": {
    "name": "Debye v2 · Version A (unslop)",
    "skill": "https://github.com/heydamir/unslop (CC BY 4.0, by Damir Sokolovsky)",
    "figma": "https://www.figma.com/design/vW4cyvW7lLOjYGOg7Ul1iJ — page 'Version A – unslop'",
    "usage": "Map into frontend/src/theme.ts. Sizes are unslop's scale, raised slightly for projection."
  },
  "color": {
    "surface": {
      "page": "#F5F7FA",
      "card": "#FFFFFF",
      "raised": "#ECEFF4",
      "sidebar": "#FFFFFF"
    },
    "border": {
      "hairline": "#E2E6EC"
    },
    "text": {
      "primary": "#0E1A2B",
      "secondary": "#4B5565",
      "muted": "#6B7487",
      "onAccent": "#FFFFFF"
    },
    "accent": {
      "base": "#12294A",
      "soft": "#E8EDF5",
      "note": "Brand navy is the only accent: primary button, selection, newest timeline item"
    },
    "signature": {
      "brass": "#A9822F",
      "brassText": "#7A5D1E",
      "note": "Only on the case-reference key tag"
    },
    "semantic": {
      "positive": "#15803D",
      "negative": "#C2261D",
      "warning": "#A15C07"
    },
    "status": {
      "requested": "#A15C07",
      "accepted": "#12294A",
      "slots_proposed": "#A15C07",
      "scheduled": "#12294A",
      "completed": "#15803D",
      "invoiced": "#15803D",
      "closed": "#6B7487",
      "declined": "#C2261D",
      "style": "8px dot + label in text.primary, no filled pill"
    }
  },
  "font": {
    "sans": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap",
    "weights": [
      400,
      500
    ],
    "notes": "Sentence case everywhere, no uppercase tracked labels, no italics. Mono for IDs, times and figures (tabular)."
  },
  "fontSize": {
    "pageTitle": {
      "size": 34,
      "lineHeight": 40,
      "weight": 500,
      "letterSpacing": "-0.01em"
    },
    "cardTitle": {
      "size": 20,
      "lineHeight": 28,
      "weight": 500
    },
    "figure": {
      "size": 30,
      "lineHeight": 34,
      "weight": 500
    },
    "body": {
      "size": 16,
      "lineHeight": 23
    },
    "secondary": {
      "size": 15,
      "lineHeight": 22
    },
    "meta": {
      "size": 14,
      "lineHeight": 20,
      "family": "mono"
    },
    "small": {
      "size": 13,
      "lineHeight": 18
    }
  },
  "radius": {
    "tag": 6,
    "control": 8,
    "row": 10,
    "card": 14
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "layout": {
    "sidebar": 256,
    "header": 64,
    "pagePadding": 32,
    "cardPadding": 24,
    "gap": 24,
    "navRow": 40,
    "tableRow": 64
  },
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,0.05)",
    "floating": "0 8px 24px rgba(0,0,0,0.06)"
  },
  "motion": {
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "hover": "150ms",
    "enter": "320ms, 8px rise, newest timeline item only"
  },
  "component": {
    "buttonPrimary": {
      "bg": "#12294A",
      "fg": "#FFFFFF",
      "radius": 8,
      "height": 44,
      "padding": "0 20px",
      "weight": 500
    },
    "buttonSecondary": {
      "bg": "#FFFFFF",
      "fg": "#0E1A2B",
      "border": "1px #E2E6EC",
      "radius": 8
    },
    "keyTag": {
      "border": "1px #A9822F",
      "radius": 6,
      "font": "mono 14",
      "hole": "6px ring"
    },
    "navActive": {
      "bg": "#ECEFF4",
      "fg": "#0E1A2B"
    },
    "slotChip": {
      "height": 48,
      "radius": 8,
      "selectedBg": "#12294A",
      "font": "mono 16"
    },
    "avatar": "docs/design/v2/mascot/debye-mascot-avatar-256.png"
  }
}