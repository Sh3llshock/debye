{
  "$meta": {
    "name": "Debye (AI assistant) design tokens",
    "source": "Derived from https://www.reltix.de/ (sampled 2026-11-20). Sizes are tuned up for projection in a large hall.",
    "usage": "Frontend: map these 1:1 into frontend/src/theme.ts and tailwind.config. Never hard-code hex values in components."
  },
  "color": {
    "brand": {
      "aubergine": "#330933",
      "aubergineDeep": "#2A072A",
      "aubergineInk": "#290629",
      "aubergine80": "#5C3A5C",
      "aubergine60": "#856B85",
      "aubergine20": "#D6CED6",
      "aubergine10": "#EBE6EB",
      "aubergine05": "#F5F2F5",
      "violet": "#8332AC",
      "violetSoft": "#F1E6F7"
    },
    "surface": {
      "page": "#FAF6F2",
      "pageWarm": "#FCF6EF",
      "card": "#FFFFFF",
      "subtle": "#F3EDE6",
      "inverse": "#330933",
      "overlay": "rgba(41, 6, 41, 0.60)"
    },
    "text": {
      "primary": "#290629",
      "heading": "#330933",
      "body": "#1A1A1A",
      "muted": "#6B6B6B",
      "onInverse": "#FFFFFF",
      "onInverseMuted": "rgba(255, 255, 255, 0.72)",
      "link": "#8332AC"
    },
    "border": {
      "default": "#E7DFD7",
      "strong": "#330933",
      "onInverse": "rgba(255, 255, 255, 0.20)"
    },
    "status": {
      "new":           { "fg": "#8332AC", "bg": "#F1E6F7", "label": "Neu" },
      "requested":     { "fg": "#8332AC", "bg": "#F1E6F7", "label": "Angefragt" },
      "accepted":      { "fg": "#1F5FA8", "bg": "#E3EEFA", "label": "Angenommen" },
      "slots_proposed":{ "fg": "#A15C07", "bg": "#FDF0DC", "label": "Termine vorgeschlagen" },
      "scheduled":     { "fg": "#1F5FA8", "bg": "#E3EEFA", "label": "Termin steht" },
      "in_progress":   { "fg": "#A15C07", "bg": "#FDF0DC", "label": "In Arbeit" },
      "completed":     { "fg": "#1E7A46", "bg": "#E2F3E8", "label": "Erledigt" },
      "invoiced":      { "fg": "#1E7A46", "bg": "#E2F3E8", "label": "Abgerechnet" },
      "closed":        { "fg": "#4A4A4A", "bg": "#EDEDED", "label": "Geschlossen" },
      "declined":      { "fg": "#B42318", "bg": "#FDE7E5", "label": "Abgelehnt" }
    },
    "priority": {
      "urgent": { "fg": "#FFFFFF", "bg": "#B42318", "label": "Dringend" },
      "high":   { "fg": "#A15C07", "bg": "#FDF0DC", "label": "Hoch" },
      "normal": { "fg": "#5C3A5C", "bg": "#EBE6EB", "label": "Normal" }
    },
    "feedback": {
      "success": "#1E7A46",
      "warning": "#A15C07",
      "danger": "#B42318",
      "info": "#1F5FA8"
    },
    "actor": {
      "debye":   { "fg": "#FFFFFF", "bg": "#330933", "icon": "Debye mark (see component.avatar)" },
      "tenant":  { "fg": "#FFFFFF", "bg": "#1E7A46", "icon": "user / chat bubble" },
      "partner": { "fg": "#FFFFFF", "bg": "#A15C07", "icon": "wrench" },
      "staff":   { "fg": "#FFFFFF", "bg": "#1F5FA8", "icon": "briefcase" },
      "system":  { "fg": "#4A4A4A", "bg": "#E7DFD7", "icon": "gear" }
    },
    "whatsapp": {
      "header": "#008069",
      "chatBg": "#EFEAE2",
      "bubbleOut": "#D9FDD3",
      "bubbleIn": "#FFFFFF",
      "tick": "#53BDEB",
      "button": "#00A884",
      "meta": "#667781"
    }
  },
  "font": {
    "family": {
      "display": "'Baskervville', 'Libre Baskerville', Georgia, serif",
      "sans": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, Menlo, monospace"
    },
    "googleFonts": "https://fonts.googleapis.com/css2?family=Baskervville:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "notes": "Same families as reltix.de. Headings: Baskervville 600 with tight negative tracking. Everything else: IBM Plex Sans. IDs, amounts in tables, JSON: IBM Plex Mono."
  },
  "fontSize": {
    "display": { "size": "64px", "lineHeight": "68px", "letterSpacing": "-0.05em", "family": "display", "weight": 600 },
    "h1":      { "size": "48px", "lineHeight": "54px", "letterSpacing": "-0.05em", "family": "display", "weight": 600 },
    "h2":      { "size": "36px", "lineHeight": "42px", "letterSpacing": "-0.04em", "family": "display", "weight": 600 },
    "h3":      { "size": "28px", "lineHeight": "34px", "letterSpacing": "-0.02em", "family": "display", "weight": 600 },
    "stat":    { "size": "56px", "lineHeight": "60px", "letterSpacing": "-0.02em", "family": "sans", "weight": 500 },
    "lead":    { "size": "24px", "lineHeight": "34px", "letterSpacing": "0", "family": "sans", "weight": 400 },
    "body":    { "size": "20px", "lineHeight": "30px", "letterSpacing": "0", "family": "sans", "weight": 400 },
    "bodySm":  { "size": "18px", "lineHeight": "26px", "letterSpacing": "0", "family": "sans", "weight": 400 },
    "label":   { "size": "16px", "lineHeight": "20px", "letterSpacing": "0.01em", "family": "sans", "weight": 500 },
    "caption": { "size": "15px", "lineHeight": "20px", "letterSpacing": "0.01em", "family": "sans", "weight": 400 },
    "eyebrow": { "size": "14px", "lineHeight": "18px", "letterSpacing": "0.08em", "family": "sans", "weight": 600, "transform": "uppercase" },
    "mono":    { "size": "16px", "lineHeight": "24px", "letterSpacing": "0", "family": "mono", "weight": 400 }
  },
  "radius": {
    "none": "0px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "28px",
    "pill": "999px"
  },
  "spacing": {
    "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },
  "layout": {
    "frameWidth": "1440px",
    "pageGutter": "48px",
    "columnGap": "32px",
    "cardPadding": "32px",
    "cardPaddingCompact": "24px",
    "topbarHeight": "80px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(51, 9, 51, 0.06), 0 6px 18px rgba(51, 9, 51, 0.06)",
    "raised": "0 8px 24px rgba(51, 9, 51, 0.14)",
    "button": "0 2px 4px rgba(51, 9, 51, 0.30)",
    "deep": "0 1px 1px rgba(51,9,51,.15), 0 3px 3px rgba(51,9,51,.15), 0 9px 9px rgba(51,9,51,.14), 0 23px 23px rgba(51,9,51,.12), 0 40px 40px rgba(51,9,51,.10), 0 72px 72px rgba(51,9,51,.05)",
    "focus": "0 0 0 3px rgba(131, 50, 172, 0.35)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "timelineEnter": "New timeline item: slide up 12px + fade in over 320ms, then background flashes violetSoft (#F1E6F7) for 1.2s."
  },
  "component": {
    "buttonPrimary":   { "bg": "#330933", "fg": "#FFFFFF", "radius": "16px", "padding": "16px 28px", "fontSize": "18px", "weight": 500, "shadow": "button", "trailingIcon": "arrow-right" },
    "buttonSecondary": { "bg": "#FFFFFF", "fg": "#330933", "border": "1.5px solid #330933", "radius": "16px", "padding": "16px 28px", "fontSize": "18px", "weight": 500 },
    "buttonGhost":     { "bg": "transparent", "fg": "#330933", "radius": "16px", "padding": "16px 20px" },
    "buttonDanger":    { "bg": "#FFFFFF", "fg": "#B42318", "border": "1.5px solid #B42318", "radius": "16px", "padding": "16px 28px" },
    "tag":             { "bg": "transparent", "fg": "#330933", "border": "1px solid #330933", "radius": "999px", "padding": "6px 14px", "fontSize": "14px" },
    "statusPill":      { "radius": "999px", "padding": "6px 16px", "fontSize": "16px", "weight": 600, "dot": "8px circle in the fg colour before the label" },
    "card":            { "bg": "#FFFFFF", "border": "1px solid #E7DFD7", "radius": "20px", "padding": "32px", "shadow": "card" },
    "cardInverse":     { "bg": "#330933", "fg": "#FFFFFF", "radius": "20px", "padding": "32px" },
    "input":           { "bg": "#FFFFFF", "border": "1.5px solid #E7DFD7", "focusBorder": "#330933", "radius": "12px", "padding": "14px 16px", "fontSize": "18px" },
    "slotChip":        { "bg": "#FFFFFF", "border": "1.5px solid #E7DFD7", "selectedBg": "#330933", "selectedFg": "#FFFFFF", "radius": "16px", "padding": "18px 20px", "fontSize": "20px" },
    "avatar":          { "debye": "Aubergine (#330933) circle, white Baskervville lowercase 'd', small violet (#8332AC) spark at top right. Sizes 32 / 48 / 96 / 512 (WhatsApp profile)." }
  }
}
