# Debye's model: ollama (this branch: fully local open-source model, see README "Running fully local"),
# openai (gpt-6-luna for chat turns, photo reading, invoice extraction) or anthropic (Claude)
LLM_PROVIDER=ollama
# Local model via Ollama's OpenAI-compatible API. debye-local = qwen3.5:2b with an 8k context:
#   ollama pull qwen3.5:2b && ollama create debye-local -f ollama/Modelfile
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=debye-local
# Local voice-note transcription (faster-whisper on the CPU): tiny / base / small
WHISPER_MODEL=base
# Seconds per Debye turn before the scripted fallback answers (default 20; 120 with LLM_PROVIDER=ollama)
AGENT_TIMEOUT=
# OpenAI (event sponsor): Debye's chat model + voice-note transcription. Our project is EU-region only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-6-luna
# gpt-6-luna needs "none" for function tools on Chat Completions; leave empty for non-reasoning models
OPENAI_REASONING_EFFORT=none
# Claude: only used with LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ElevenLabs: optional Debye voice replies (event sponsor)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Calls with Debye (docs/voice-setup.md): shared secret for the agent's server tools, agent id printed by
# scripts/elevenlabs_agent.py; optional: agent voice/LLM, HMAC secret of the post-call webhook
VOICE_TOOL_SECRET=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_VOICE_ID=
ELEVENLABS_AGENT_LLM=
ELEVENLABS_WEBHOOK_SECRET=
# WhatsApp provider: wweb (linked phone via bridge/, demo route), twilio (sandbox) or meta (Cloud API).
# Default without WA_PROVIDER: twilio when TWILIO_ACCOUNT_SID is set, else meta.
WA_PROVIDER=wweb
# Linked-phone bridge (bridge/, scripts/start_bridge.ps1): shared HMAC secret for both directions
WWEB_SECRET=change-me
WWEB_BRIDGE_URL=http://127.0.0.1:3010
# Twilio WhatsApp sandbox (Console > Messaging > Try it out > Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WhatsApp Cloud API (Meta), used with WA_PROVIDER=meta
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=
# App
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=1
FIBRE_SECRET=change-me
